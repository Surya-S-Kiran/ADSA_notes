==================================================
29. COMMON DSA PATTERNS
==================================================

FREQUENCY MAP:

unordered_map<int, int> mp;

for(int x : nums) {
    mp[x]++;
}


CHECK DUPLICATE:

unordered_set<int> s;

for(int x : nums) {
    if(s.find(x) != s.end()) {
        cout << "Duplicate";
    }

    s.insert(x);
}


MIN HEAP:

priority_queue<int, vector<int>, greater<int>> pq;


MAX HEAP:

priority_queue<int> pq;


SORT + BINARY SEARCH:

sort(nums.begin(), nums.end());

int index = lower_bound(nums.begin(), nums.end(), x)
          - nums.begin();


REMOVE DUPLICATES:

sort(nums.begin(), nums.end());

nums.erase(unique(nums.begin(), nums.end()), nums.end());


SUM:

long long sum = accumulate(nums.begin(), nums.end(), 0LL);


REMOVE ELEMENT:

nums.erase(remove(nums.begin(), nums.end(), x), nums.end());


==================================================
30. TIME COMPLEXITY
==================================================

                    INSERT       SEARCH       DELETE

vector              O(1)*        O(n)         O(n)

set                 O(log n)     O(log n)     O(log n)

unordered_set       O(1)*        O(1)*        O(1)*

map                 O(log n)     O(log n)     O(log n)

unordered_map       O(1)*        O(1)*        O(1)*

priority_queue      O(log n)     O(1) top     O(log n)

stack               O(1)         O(1) top     O(1)

queue               O(1)         O(1) front   O(1)

* Average/amortized complexity.


