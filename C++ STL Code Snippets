14. BINARY SEARCH
==================================================

Vector must be sorted.

sort(v.begin(), v.end());

if(binary_search(v.begin(), v.end(), x)) {
    cout << "Found";
}


==================================================
15. LOWER_BOUND
==================================================

Returns iterator to first element >= x.

auto it = lower_bound(v.begin(), v.end(), x);

Get index:
int index = lower_bound(v.begin(), v.end(), x) - v.begin();

Example:
v = {1, 3, 3, 5, 7}

lower_bound(v.begin(), v.end(), 3)
-> index 1


==================================================
16. UPPER_BOUND
==================================================

Returns iterator to first element > x.

auto it = upper_bound(v.begin(), v.end(), x);

Get index:
int index = upper_bound(v.begin(), v.end(), x) - v.begin();

Example:
v = {1, 3, 3, 5, 7}

upper_bound(v.begin(), v.end(), 3)
-> index 3


==================================================
17. COUNT
==================================================

Count occurrences:

int cnt = count(v.begin(), v.end(), x);

For sorted vector:

int cnt = upper_bound(v.begin(), v.end(), x)
        - lower_bound(v.begin(), v.end(), x);


==================================================
18. FIND
==================================================

Vector:

auto it = find(v.begin(), v.end(), x);

if(it != v.end()) {
    cout << "Found";
}

Set/map:

if(s.find(x) != s.end()) {
    cout << "Found";
}


