# C++ STL CHEAT SHEET

Quick reference for C++ STL used in DSA and competitive programming.

==================================================
1. VECTOR
==================================================

Declaration:
vector<int> v;
vector<int> v(5);
vector<int> v(5, 10);

Add:
v.push_back(10);
v.emplace_back(20);

Access:
v[0];
v.at(0);
v.front();
v.back();

Size:
v.size();
v.empty();

Remove:
v.pop_back();
v.clear();

Iterate:
for(int x : v) {
    cout << x << " ";
}

Iterator:
for(auto it = v.begin(); it != v.end(); it++) {
    cout << *it << " ";
}

Erase one:
v.erase(v.begin() + index);

Erase range [l, r):
v.erase(v.begin() + l, v.begin() + r);


==================================================
2. PAIR
==================================================

Declaration:
pair<int, int> p;
pair<int, int> p = {10, 20};

Access:
p.first;
p.second;

Vector of pairs:
vector<pair<int,int>> v;

v.push_back({1, 10});
v.push_back({2, 20});


==================================================
3. STRING
==================================================

Declaration:
string s = "hello";

Access:
s[0];
s.front();
s.back();

Size:
s.size();
s.length();

Add:
s.push_back('a');
s += "world";

Remove:
s.pop_back();

Reverse:
reverse(s.begin(), s.end());

Sort:
sort(s.begin(), s.end());

Find:
if(s.find("abc") != string::npos) {
    cout << "Found";
}


==================================================
4. SET
==================================================

Unique + sorted elements.

Declaration:
set<int> s;

Insert:
s.insert(10);
s.insert(20);

Find:
if(s.find(x) != s.end()) {
    cout << "Found";
}

Erase:
s.erase(x);

Size:
s.size();

Iterate:
for(int x : s) {
    cout << x << " ";
}


==================================================
5. UNORDERED_SET
==================================================

Unique elements, no sorting.

Declaration:
unordered_set<int> s;

Insert:
s.insert(x);

Find:
if(s.find(x) != s.end()) {
    cout << "Found";
}

Erase:
s.erase(x);


==================================================
6. MAP
==================================================

Key-value pairs with sorted keys.

Declaration:
map<int, int> mp;

Insert:
mp[10] = 100;
mp.insert({20, 200});

Access:
cout << mp[10];

Frequency:
for(int x : nums) {
    mp[x]++;
}

Find:
if(mp.find(x) != mp.end()) {
    cout << "Found";
}

Erase:
mp.erase(x);

Iterate:
for(auto p : mp) {
    cout << p.first << " " << p.second << "\n";
}

Structured binding:
for(auto [key, value] : mp) {
    cout << key << " " << value << "\n";
}


==================================================
7. UNORDERED_MAP
==================================================

Key-value pairs using hashing.

Declaration:
unordered_map<int, int> mp;

Frequency:
for(int x : nums) {
    mp[x]++;
}

Find:
if(mp.find(x) != mp.end()) {
    cout << "Found";
}

Erase:
mp.erase(x);

Iterate:
for(auto [key, value] : mp) {
    cout << key << " " << value << "\n";
}


==================================================
8. STACK
==================================================

LIFO = Last In First Out.

Declaration:
stack<int> st;

Push:
st.push(10);
st.push(20);

Top:
st.top();

Pop:
st.pop();

Empty:
st.empty();

Common pattern:
while(!st.empty()) {
    cout << st.top() << " ";
    st.pop();
}


==================================================
9. QUEUE
==================================================

FIFO = First In First Out.

Declaration:
queue<int> q;

Push:
q.push(10);
q.push(20);

Front:
q.front();

Back:
q.back();

Pop:
q.pop();

Common pattern:
while(!q.empty()) {
    cout << q.front() << " ";
    q.pop();
}


==================================================
10. DEQUE
==================================================

Insertion/removal from both ends.

Declaration:
deque<int> dq;

Add:
dq.push_back(10);
dq.push_front(20);

Remove:
dq.pop_back();
dq.pop_front();

Access:
dq.front();
dq.back();


==================================================
11. PRIORITY QUEUE
==================================================

MAX HEAP:

priority_queue<int> pq;

Push:
pq.push(10);
pq.push(30);
pq.push(20);

Top:
pq.top();       // 30

Pop:
pq.pop();


MIN HEAP:

priority_queue<int, vector<int>, greater<int>> pq;

pq.push(30);
pq.push(10);
pq.push(20);

pq.top();       // 10


==================================================
12. SORT
==================================================

Ascending:
sort(v.begin(), v.end());

Descending:
sort(v.rbegin(), v.rend());

Array:
sort(arr, arr + n);

Custom sorting:
sort(v.begin(), v.end(), [](int a, int b) {
    return a > b;
});

Sort pairs by second:
sort(v.begin(), v.end(), [](pair<int,int> a, pair<int,int> b) {
    return a.second < b.second;
});


==================================================
13. REVERSE
==================================================

Vector:
reverse(v.begin(), v.end());

String:
reverse(s.begin(), s.end());


